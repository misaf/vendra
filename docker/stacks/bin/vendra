#!/bin/sh
#
# Vendra estate control.
#
# Brings up the proxy, the platform, and (when configured) the marketing site.
# This is a host-level script on purpose: the platform runs *inside* the stack it
# would otherwise be asked to start, so it cannot bootstrap itself. Everything
# after bring-up — storefronts, reconciliation, status — is an artisan command
# inside the platform container, reachable through `vendra artisan`.
#
# Certificates are Traefik's. Publicly it uses the ACME resolver; locally it
# serves whatever certificate is in <state>/certificates (use mkcert). Nothing
# here generates a CA.

set -eu

STACKS_DIR="$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)"
PROJECT_DIR="$(CDPATH='' cd -- "${STACKS_DIR}/../.." && pwd)"
APP_ENV_FILE="${VENDRA_ENV_FILE:-${PROJECT_DIR}/.env}"
DOCKER_ENV_FILE="${VENDRA_DOCKER_ENV_FILE:-${STACKS_DIR}/.env}"
DEV_MODE=false

die() { printf '%s\n' "vendra: $*" >&2; exit 1; }
info() { printf '\033[1m==>\033[0m %s\n' "$*"; }

[ -f "$APP_ENV_FILE" ] || die "no application environment at ${APP_ENV_FILE} (copy ${PROJECT_DIR}/.env.example to ${PROJECT_DIR}/.env)"
[ -f "$DOCKER_ENV_FILE" ] || die "no Docker environment at ${DOCKER_ENV_FILE} (copy ${STACKS_DIR}/.env.example to ${STACKS_DIR}/.env)"

# Read only the small set of values the host-side CLI needs. An env file is not
# a shell script: sourcing it makes otherwise valid dotenv values executable and
# gives shell syntax a different meaning from Compose's dotenv parser.
dotenv_value() {
	key="$1"
	file="$2"
	awk -v key="$key" '
		$0 ~ "^[[:space:]]*" key "[[:space:]]*=" {
			value = $0
			sub("^[[:space:]]*" key "[[:space:]]*=[[:space:]]*", "", value)
			sub(/[[:space:]]+$/, "", value)
			if ((value ~ /^".*"$/) || (value ~ /^\047.*\047$/)) {
				value = substr(value, 2, length(value) - 2)
			}
			print value
			exit
		}
	' "$file"
}

config_value() {
	key="$1"
	default_value="${2:-}"
	if value="$(printenv "$key" 2>/dev/null)"; then
		printf '%s\n' "$value"
		return
	fi
	value="$(dotenv_value "$key" "$DOCKER_ENV_FILE")"
	if [ -n "$value" ]; then
		printf '%s\n' "$value"
		return
	fi
	value="$(dotenv_value "$key" "$APP_ENV_FILE")"
	printf '%s\n' "${value:-$default_value}"
}

reject_duplicate_keys() {
	duplicates="$(
		awk -F= '
			/^[[:space:]]*[A-Za-z_][A-Za-z0-9_]*[[:space:]]*=/ {
				key = $1
				gsub(/[[:space:]]/, "", key)
				if (FILENAME == ARGV[1]) {
					application_keys[key] = 1
				} else if (application_keys[key]) {
					print key
				}
			}
		' "$APP_ENV_FILE" "$DOCKER_ENV_FILE" | sort -u
	)"
	[ -z "$duplicates" ] || die "keys must have one owner; duplicated in ${APP_ENV_FILE} and ${DOCKER_ENV_FILE}: $(printf '%s' "$duplicates" | tr '\n' ' ')"
}

BASE_DOMAIN="$(config_value BASE_DOMAIN)"
NETWORK="$(config_value STOREFRONT_NETWORK traefik-public)"

# Docker and Podman both serve the Engine API and the same compose files, so
# the estate is driven through whichever one you name. Rootless
# Podman is the safer choice: the socket the storefront worker mounts is then
# not root-equivalent on the host.
RUNTIME="$(config_value CONTAINER_RUNTIME docker)"

command -v "$RUNTIME" >/dev/null 2>&1 || die "${RUNTIME} is not installed"
"$RUNTIME" compose version >/dev/null 2>&1 || die "${RUNTIME} compose v2 is required"

# The website is optional. Without an image there is nothing to run, and the
# apex host stays with the panels rather than pointing at a stack that is down.
VENDRA_WEBSITE_IMAGE="$(config_value VENDRA_WEBSITE_IMAGE)"
if [ -n "$VENDRA_WEBSITE_IMAGE" ]; then
	STACKS="proxy platform website"
else
	STACKS="proxy platform"
fi

STATE_DIR="$(config_value VENDRA_STATE_DIR /var/lib/vendra)"

# HSTS is deliberately off unless real certificates are in play. Sending it with
# a certificate the browser does not trust pins the host to HTTPS *and* removes
# the "proceed anyway" bypass, leaving a local .test host unreachable until the
# someone clears HSTS state by hand.
CERT_RESOLVER="$(config_value CERT_RESOLVER)"
TRAEFIK_HSTS_SECONDS="$(config_value TRAEFIK_HSTS_SECONDS)"
if [ -n "$CERT_RESOLVER" ]; then
	TRAEFIK_HSTS_SECONDS="${TRAEFIK_HSTS_SECONDS:-31536000}"
else
	TRAEFIK_HSTS_SECONDS="${TRAEFIK_HSTS_SECONDS:-0}"
fi
export TRAEFIK_HSTS_SECONDS

# Traefik only names a default certificate when one is actually there. Under
# ACME there is none, and pointing at absent files makes it log an error on
# every reload.
if [ -f "${STATE_DIR}/certificates/local.pem" ]; then
	VENDRA_DEFAULT_CERTIFICATE=1
else
	VENDRA_DEFAULT_CERTIFICATE=""
fi
export VENDRA_DEFAULT_CERTIFICATE

compose() {
	stack="$1"
	shift
	if [ "$DEV_MODE" = "true" ] && [ "$stack" = "platform" ]; then
		"$RUNTIME" compose \
			--project-directory "${STACKS_DIR}/${stack}" \
			--env-file "$APP_ENV_FILE" \
			--env-file "$DOCKER_ENV_FILE" \
			-f "${STACKS_DIR}/${stack}/docker-compose.yml" \
			-f "${STACKS_DIR}/${stack}/docker-compose.dev.yml" \
			"$@"
		return
	fi
	"$RUNTIME" compose \
		--project-directory "${STACKS_DIR}/${stack}" \
		--env-file "$APP_ENV_FILE" \
		--env-file "$DOCKER_ENV_FILE" \
		-f "${STACKS_DIR}/${stack}/docker-compose.yml" \
		"$@"
}

preflight() {
	reject_duplicate_keys
	missing=""
	for key in APP_KEY BASE_DOMAIN DB_PASSWORD DB_ROOT_PASSWORD VENDRA_PLATFORM_IMAGE; do
		[ -n "$(config_value "$key")" ] || missing="${missing} ${key}"
	done
	[ -z "$missing" ] || die "missing required values in ${APP_ENV_FILE} or ${DOCKER_ENV_FILE}:${missing}"

	"$RUNTIME" info >/dev/null 2>&1 || die "cannot reach the ${RUNTIME} daemon"

	for stack in $STACKS; do
		compose "$stack" config --quiet || die "invalid ${stack} Compose configuration"
	done
}

cmd_config() {
	preflight
	if "$RUNTIME" network inspect "$NETWORK" >/dev/null 2>&1; then
		network_status=ready
	else
		network_status="missing (created by vendra up)"
	fi

	printf 'application: %s\n' "$APP_ENV_FILE"
	printf 'docker:      %s\n' "$DOCKER_ENV_FILE"
	if [ "$DEV_MODE" = "true" ]; then
		printf 'mode:        local development\n'
	else
		printf 'mode:        production\n'
	fi
	printf 'runtime:     %s\n' "$RUNTIME"
	printf 'domain:      %s\n' "$BASE_DOMAIN"
	printf 'stacks:      %s\n' "$STACKS"
	printf 'network:     %s — %s\n' "$NETWORK" "$network_status"
	printf 'configuration is valid\n'
}

# Traefik needs these to exist before it starts: it mounts both, and the runtime
# would otherwise create them as root-owned directories.
ensure_state() {
	mkdir -p "${STATE_DIR}/certificates" "${STATE_DIR}/acme"
	[ -f "${STATE_DIR}/acme/acme.json" ] || (umask 077; printf '{}' >"${STATE_DIR}/acme/acme.json")
}

ensure_network() {
	if ! "$RUNTIME" network inspect "$NETWORK" >/dev/null 2>&1; then
		info "creating network ${NETWORK}"
		"$RUNTIME" network create "$NETWORK" >/dev/null
	fi
}

cmd_up() {
	preflight
	ensure_state
	ensure_network
	for stack in $STACKS; do
		info "starting ${stack}"
		if [ "$DEV_MODE" != "true" ] && [ "$(config_value VENDRA_NO_PULL false)" != "true" ]; then
			compose "$stack" pull --quiet
		fi
		compose "$stack" up -d --remove-orphans --wait
	done
	cmd_urls
}

cmd_down() {
	# shellcheck disable=SC2086
	for stack in $(printf '%s\n' $STACKS | tac 2>/dev/null || printf '%s\n' $STACKS | tail -r); do
		info "stopping ${stack}"
		compose "$stack" down
	done
}

cmd_ps() {
	for stack in $STACKS; do
		printf '\n%s:\n' "$stack"
		compose "$stack" ps
	done
	printf '\nstorefronts:\n'
	"$RUNTIME" ps --filter "label=io.vendra.managed-by=vendra" \
		--format 'table {{.Names}}\t{{.Status}}\t{{.Label "io.vendra.domain"}}'
}

cmd_logs() {
	target="${1:-}"
	case "$target" in
		proxy | website) compose "$target" logs -f ;;
		'') compose platform logs -f ;;
		*)
			if "$RUNTIME" inspect "$target" >/dev/null 2>&1; then
				"$RUNTIME" logs -f "$target"
			else
				compose platform logs -f "$target"
			fi
			;;
	esac
}

cmd_artisan() {
	compose platform exec -T php php artisan "$@"
}

cmd_restart_workers() {
	compose platform restart horizon storefront-worker scheduler pulse pulse-worker
}

cmd_dev() {
	DEV_MODE=true
	subcommand="${1:-}"
	[ $# -gt 0 ] && shift

	case "$subcommand" in
		config) cmd_config ;;
		up) cmd_up ;;
		down) cmd_down ;;
		restart) cmd_down; cmd_up ;;
		restart-workers) cmd_restart_workers ;;
		logs) cmd_logs "$@" ;;
		artisan) cmd_artisan "$@" ;;
		*) usage >&2; die "unknown development command: ${subcommand:-<empty>}" ;;
	esac
}

cmd_urls() {
	printf '\n'
	printf '  site      https://%s\n' "$BASE_DOMAIN"
	printf '  admin     https://admin.%s\n' "$BASE_DOMAIN"
	printf '  console   https://console.%s\n' "$BASE_DOMAIN"
	printf '  reseller  https://reseller.%s\n' "$BASE_DOMAIN"
	printf '  api       https://api.%s\n' "$BASE_DOMAIN"
	printf '\n'
}

# Local estates run on a domain no public DNS resolves. This writes the hosts
# entries for the platform names; storefront domains are listed by `hosts` so
# they can be added the same way.
cmd_hosts() {
	names="$BASE_DOMAIN admin.$BASE_DOMAIN console.$BASE_DOMAIN reseller.$BASE_DOMAIN api.$BASE_DOMAIN"
	for domain in $("$RUNTIME" ps --filter "label=io.vendra.managed-by=vendra" \
		--format '{{.Label "io.vendra.domain"}}' | sort -u); do
		[ -n "$domain" ] && names="$names $domain www.$domain"
	done
	printf '# BEGIN VENDRA\n127.0.0.1 %s\n# END VENDRA\n' "$names"
	printf '\n# Append the block above to /etc/hosts (sudo required).\n' >&2
}

# Local estates need a certificate Traefik can serve for BASE_DOMAIN and every
# storefront domain. mkcert produces one and installs its CA in the system trust
# store, which is why this shells out rather than generating anything itself.
cmd_certs() {
	command -v mkcert >/dev/null 2>&1 || die "mkcert is not installed (brew install mkcert)"
	ensure_state
	names="$BASE_DOMAIN *.$BASE_DOMAIN *.admin.$BASE_DOMAIN"
	for domain in $("$RUNTIME" ps --filter "label=io.vendra.managed-by=vendra" \
		--format '{{.Label "io.vendra.domain"}}' | sort -u); do
		[ -n "$domain" ] && names="$names $domain www.$domain"
	done
	info "issuing ${STATE_DIR}/certificates/local.pem for: ${names}"
	# shellcheck disable=SC2086
	mkcert -cert-file "${STATE_DIR}/certificates/local.pem" \
		-key-file "${STATE_DIR}/certificates/local-key.pem" $names
	info "restart the proxy to pick it up: vendra restart"
}

usage() {
	cat <<'USAGE'
vendra <command>

  config             validate and summarize the active configuration
  up                 validate config, ensure the network, start every stack
  down               stop every stack
  restart            down then up
  ps                 stack services and the storefront fleet
  logs [target]      follow logs (proxy | website | <service> | <container>)
  artisan <args>     run artisan inside the platform container
  urls               print the estate's URLs
  hosts              print an /etc/hosts block for a local estate
  certs              issue a local certificate with mkcert (local estates only)

vendra dev <command>

  config             validate the local bind-mount configuration
  up                 start with the current checkout mounted at /app
  down               stop the local estate
  restart            restart the local estate
  restart-workers    reload long-running Laravel processes after code changes
  logs [target]      follow local estate logs
  artisan <args>     run Artisan in the local PHP container
USAGE
}

command="${1:-}"
[ $# -gt 0 ] && shift

case "$command" in
	dev) cmd_dev "$@" ;;
	config) cmd_config ;;
	up) cmd_up ;;
	down) cmd_down ;;
	restart) cmd_down; cmd_up ;;
	ps) cmd_ps ;;
	logs) cmd_logs "$@" ;;
	artisan) cmd_artisan "$@" ;;
	urls) cmd_urls ;;
	hosts) cmd_hosts ;;
	certs) cmd_certs ;;
	'' | -h | --help | help) usage ;;
	*) usage >&2; die "unknown command: ${command}" ;;
esac
