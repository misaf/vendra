{
    "name": "misaf/vendra-tagger",
    "description": "Tenant-aware tag management and Filament administration for Vendra",
    "keywords": [
        "laravel",
        "filamentphp",
        "misaf",
        "vendra",
        "tagger"
    ],
    "homepage": "https://github.com/misaf/vendra-tagger",
    "license": "MIT",
    "authors": [
        {
            "name": "Ehsan Mahmoodi",
            "email": "misaf.1990@gmail.com",
            "role": "Developer"
        }
    ],
    "type": "vendra-module",
    "require": {
        "php": "^8.4",
        "awcodes/filament-badgeable-column": "^4.0",
        "filament/spatie-laravel-tags-plugin": "^5.6.8",
        "lara-zeus/spatie-translatable": "^2.0.1",
        "misaf/filament-jalali": "^5.1.4",
        "misaf/vendra-support": "self.version",
        "spatie/eloquent-sortable": "^5.0.1",
        "spatie/laravel-package-tools": "^1.93.1",
        "spatie/laravel-tags": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Misaf\\VendraTagger\\": "src/",
            "Misaf\\VendraTagger\\Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Misaf\\VendraTagger\\Database\\Factories\\": "database/factories/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Misaf\\VendraTagger\\Providers\\TaggerServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "phpstan/extension-installer": true
        },
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "support": {
        "issues": "https://github.com/misaf/vendra-tagger/issues",
        "source": "https://github.com/misaf/vendra-tagger"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "$schema": "https://getcomposer.org/schema.json"
}
