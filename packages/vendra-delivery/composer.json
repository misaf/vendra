{
    "name": "misaf/vendra-delivery",
    "description": "Delivery zones, schedules, and fee rules for Vendra applications",
    "keywords": [
        "laravel",
        "filamentphp",
        "misaf",
        "vendra",
        "delivery"
    ],
    "homepage": "https://github.com/misaf/vendra-delivery",
    "license": "MIT",
    "authors": [
        {
            "name": "Ehsan Mahmoodi",
            "email": "misaf.1990@gmail.com",
            "role": "Developer"
        }
    ],
    "type": "vendra-module",
    "require": {
        "php": "^8.4",
        "cknow/laravel-money": "^8.5",
        "lara-zeus/spatie-translatable": "^2.0.1",
        "misaf/filament-jalali": "^5.1.4",
        "misaf/vendra-address": "self.version",
        "misaf/vendra-order": "self.version",
        "misaf/vendra-support": "self.version",
        "spatie/eloquent-sortable": "^5.0.1",
        "spatie/laravel-package-tools": "^1.93.1",
        "spatie/laravel-settings": "^3.9"
    },
    "autoload": {
        "psr-4": {
            "Misaf\\VendraDelivery\\": "src/",
            "Misaf\\VendraDelivery\\Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Misaf\\VendraDelivery\\Database\\Factories\\": "database/factories/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Misaf\\VendraDelivery\\Providers\\DeliveryServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "phpstan/extension-installer": true
        },
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "support": {
        "issues": "https://github.com/misaf/vendra-delivery/issues",
        "source": "https://github.com/misaf/vendra-delivery"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "$schema": "https://getcomposer.org/schema.json"
}
