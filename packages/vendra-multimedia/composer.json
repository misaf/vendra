{
    "name": "misaf/vendra-multimedia",
    "description": "Media library integration and Filament media management for Vendra",
    "keywords": [
        "laravel",
        "filamentphp",
        "misaf",
        "vendra",
        "multimedia"
    ],
    "homepage": "https://github.com/misaf/vendra-multimedia",
    "license": "MIT",
    "authors": [
        {
            "name": "Ehsan Mahmoodi",
            "email": "misaf.1990@gmail.com",
            "role": "Developer"
        }
    ],
    "type": "vendra-module",
    "require": {
        "php": "^8.4",
        "awcodes/filament-badgeable-column": "^4.0",
        "filament/spatie-laravel-media-library-plugin": "^5.6.8",
        "misaf/filament-jalali": "^5.1.4",
        "misaf/vendra-support": "self.version",
        "spatie/laravel-medialibrary": "^11.23.2",
        "spatie/laravel-package-tools": "^1.93.1"
    },
    "autoload": {
        "psr-4": {
            "Misaf\\VendraMultimedia\\": "src/",
            "Misaf\\VendraMultimedia\\Database\\Seeders\\": "database/seeders/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Misaf\\VendraMultimedia\\Providers\\MultimediaServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "phpstan/extension-installer": true
        },
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "support": {
        "issues": "https://github.com/misaf/vendra-multimedia/issues",
        "source": "https://github.com/misaf/vendra-multimedia"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "$schema": "https://getcomposer.org/schema.json"
}
