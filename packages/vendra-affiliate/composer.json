{
    "name": "misaf/vendra-affiliate",
    "description": "Affiliate and referral management system with commission tracking and user referral capabilities",
    "keywords": [
        "laravel",
        "filamentphp",
        "affiliate"
    ],
    "homepage": "https://github.com/misaf/vendra-affiliate",
    "license": "MIT",
    "authors": [
        {
            "name": "Ehsan Mahmoodi",
            "email": "misaf.1990@gmail.com",
            "role": "Developer"
        }
    ],
    "type": "vendra-module",
    "require": {
        "php": "^8.4",
        "misaf/vendra-support": "self.version",
        "misaf/vendra-transaction": "self.version",
        "misaf/vendra-user": "self.version",
        "spatie/laravel-package-tools": "^1.93.1",
        "spatie/laravel-queueable-action": "^2.17",
        "spatie/laravel-settings": "^3.9"
    },
    "autoload": {
        "psr-4": {
            "Misaf\\VendraAffiliate\\": "src/",
            "Misaf\\VendraAffiliate\\Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Misaf\\VendraAffiliate\\Database\\Factories\\": "database/factories/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Misaf\\VendraAffiliate\\Providers\\AffiliateServiceProvider"
            ]
        }
    },
    "suggest": {
        "misaf/vendra-tagger": "Install this in the host application to assign typed tags to affiliates."
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "phpstan/extension-installer": true
        },
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "support": {
        "issues": "https://github.com/misaf/vendra-affiliate/issues",
        "source": "https://github.com/misaf/vendra-affiliate"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "$schema": "https://getcomposer.org/schema.json"
}
