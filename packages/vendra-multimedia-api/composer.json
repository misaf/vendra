{
    "name": "misaf/vendra-multimedia-api",
    "description": "API services for the vendra-multimedia module",
    "keywords": [
        "laravel",
        "filamentphp",
        "misaf",
        "vendra",
        "multimedia-api"
    ],
    "homepage": "https://github.com/misaf/vendra-multimedia-api",
    "license": "MIT",
    "authors": [
        {
            "name": "Ehsan Mahmoodi",
            "email": "misaf.1990@gmail.com",
            "role": "Developer"
        }
    ],
    "type": "vendra-module",
    "require": {
        "php": "^8.4",
        "illuminate/support": "^13.0",
        "misaf/vendra-api": "self.version",
        "misaf/vendra-multimedia": "self.version",
        "misaf/vendra-support": "self.version",
        "spatie/laravel-package-tools": "^1.93.1"
    },
    "autoload": {
        "psr-4": {
            "Misaf\\VendraMultimediaApi\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Misaf\\VendraMultimediaApi\\Providers\\MultimediaApiServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "phpstan/extension-installer": true
        },
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "support": {
        "issues": "https://github.com/misaf/vendra-multimedia-api/issues",
        "source": "https://github.com/misaf/vendra-multimedia-api"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "$schema": "https://getcomposer.org/schema.json"
}
