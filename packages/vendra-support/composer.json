{
    "name": "misaf/vendra-support",
    "description": "Shared support classes for Vendra modules",
    "keywords": [
        "laravel",
        "filamentphp",
        "misaf",
        "vendra",
        "vendra-support"
    ],
    "homepage": "https://github.com/misaf/vendra-support",
    "license": "MIT",
    "authors": [
        {
            "name": "Ehsan Mahmoodi",
            "email": "misaf.1990@gmail.com",
            "role": "Developer"
        }
    ],
    "type": "vendra-module",
    "require": {
        "php": "^8.4",
        "filament/filament": "^5.6.8",
        "filament/spatie-laravel-settings-plugin": "^5.6.8",
        "illuminate/console": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/support": "^13.0",
        "laravel/prompts": "^0.3.21",
        "misaf/filament-jalali": "^5.1.4",
        "spatie/laravel-settings": "^3.9",
        "symfony/intl": "^7.4 || ^8.0"
    },
    "autoload": {
        "psr-4": {
            "Misaf\\VendraSupport\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Misaf\\VendraSupport\\Providers\\SupportServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "phpstan/extension-installer": true
        },
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "support": {
        "issues": "https://github.com/misaf/vendra-support/issues",
        "source": "https://github.com/misaf/vendra-support"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "$schema": "https://getcomposer.org/schema.json"
}
