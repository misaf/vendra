parameters:

    paths:
        - app
        - packages

    # Only package sources are analysed; paths does not accept wildcards
    excludePaths:
        - packages/*/config/*
        - packages/*/database/*
        - packages/*/resources/*
        - packages/*/routes/*
        - packages/*/tests/*

    stubFiles:
        - packages/vendra-api/phpstan.stub

    # Level 10 is the highest level
    level: 10
#
#    excludePaths:
#        - ./*/*/FileToBeExcluded.php
#
#    checkMissingIterableValueType: false
