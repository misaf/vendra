APP_NAME=Vendra
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://localhost
ASSET_URL=https://localhost
TIMEZONE=UTC

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_DATABASE=vendra
DB_USERNAME=vendra
DB_PASSWORD=change-this-db-password

REDIS_HOST=127.0.0.1

CACHE_STORE=redis
SETTINGS_CACHE_ENABLED=true
QUEUE_CONNECTION=redis

SESSION_DRIVER=redis
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_DOMAIN=null

FILESYSTEM_DISK=public

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=1025
MAIL_FROM_ADDRESS=hello@localhost
MAIL_FROM_NAME="${APP_NAME}"

# The estate runs in containers and the runtime collects stderr; a file
# channel would write into each container's own layer and vanish with it.
LOG_CHANNEL=stderr
LOG_LEVEL=warning

APP_MAINTENANCE_DRIVER=cache
APP_MAINTENANCE_STORE=redis

PULSE_INGEST_DRIVER=redis
PULSE_REDIS_CONNECTION=cache
HORIZON_NOTIFY_MAIL=
DEBUGBAR_ENABLED=false

# Console bootstrap
CONSOLE_USER_EMAIL=console@localhost
CONSOLE_USER_PASSWORD=change-this-app-console-user-password

# Console branding. Platform rules a console user can edit are settings rows, not env.
CONSOLE_PLATFORM_NAME="Vendra Console"

# OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://localhost/oauth/callback/google

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=https://localhost/oauth/callback/github

# Storefront provisioning
#
# How a storefront deployment becomes a running container: the platform manages
# the containers itself, through the container runtime below. Docker and a
# Podman compatibility socket are both supported.
#
# Which Laravel Docker Engine driver answers storefront requests.
CONTAINER_DRIVER=docker

# Each driver has its own Engine endpoint, API version, and timeouts. Empty API
# versions negotiate the package default. Use `php artisan container:info
# --driver=podman` (or docker) to confirm which daemon answers.
DOCKER_HOST=unix:///var/run/docker.sock
DOCKER_API_VERSION=
DOCKER_CONNECT_TIMEOUT=5
DOCKER_REQUEST_TIMEOUT=60
DOCKER_STREAM_IDLE_TIMEOUT=

PODMAN_HOST=unix:///run/user/1000/podman/podman.sock
PODMAN_API_VERSION=
PODMAN_CONNECT_TIMEOUT=5
PODMAN_REQUEST_TIMEOUT=60
PODMAN_STREAM_IDLE_TIMEOUT=

# The platform creates one container per storefront and nothing else: the
# network, the reverse proxy, and the TLS material belong to whoever runs the
# estate. The network must already exist.
STOREFRONT_NETWORK=traefik-public

# Skip the registry pull so a locally built image can be started.
STOREFRONT_PULL=true
STOREFRONT_PORT=3000
STOREFRONT_HEALTH_PATH=/api/health
STOREFRONT_HEALTH_TIMEOUT=120

# Per-storefront resource caps, so one busy storefront cannot starve the rest
# of the fleet. Empty or 0 lifts that cap.
STOREFRONT_CPUS=0.5
STOREFRONT_MEMORY_MB=512
STOREFRONT_MEMORY_RESERVATION_MB=0

# Processes and threads one storefront may hold open. A Next.js server needs a
# few dozen, so this only stops a runaway from exhausting the host's pid_max.
STOREFRONT_PIDS_LIMIT=512

# json-file and its rotation limits are Docker's. On Podman use k8s-file, or
# leave empty to inherit whatever the runtime is configured to do.
STOREFRONT_LOG_DRIVER=json-file
STOREFRONT_LOG_MAX_SIZE=10m
STOREFRONT_LOG_MAX_FILE=5

# Base domain the storefronts call the API on, unless STOREFRONT_API_URL is set.
STOREFRONT_BASE_DOMAIN=
STOREFRONT_API_URL=

# Traefik certificate resolver, e.g. letsencrypt. Empty leaves TLS to the proxy's
# default certificate.
STOREFRONT_CERT_RESOLVER=

# Read-only certificate mount, needed only when the API is served with a
# certificate no public root signs. Empty disables the mount.
STOREFRONT_CERTIFICATES_PATH=
STOREFRONT_CA_FILE=
